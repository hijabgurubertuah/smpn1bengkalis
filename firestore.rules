rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // School portal content is publicly readable, writable for demo/admin
    match /school_config/{document=**} {
      allow read, write: if true;
    }
    match /news_articles/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
